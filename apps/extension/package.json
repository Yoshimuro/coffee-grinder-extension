{
  "name": "@coffee/extension",
  "version": "0.2.0",
  "private": true,
  "description": "Chrome extension that converts grind settings between coffee grinders via a micron scale.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite build --watch --mode development",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@coffee/core": "*"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.0.287",
    "@types/node": "22.10.2",
    "typescript": "5.7.3",
    "vite": "6.0.7",
    "vitest": "2.1.8"
  }
}
