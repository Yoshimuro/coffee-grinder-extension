    "screenshot": "node scripts/screens.mjs",
    "cap:sync": "npm run build && cap sync android"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "5.0.1",
    "@capacitor-community/speech-recognition": "6.0.1",
    "@capacitor/android": "6.2.1",
    "@capacitor/app": "6.0.3",
    "@capacitor/camera": "6.1.3",
    "@capacitor/core": "6.2.1",
    "@capacitor/filesystem": "6.0.4",
    "@capacitor/local-notifications": "6.1.3",
    "@capacitor/share": "6.0.4",
    "@coffee/core": "*",
    "@fontsource/jetbrains-mono": "5.3.0",
    "dexie": "4.4.4",
    "dexie-react-hooks": "4.4.0",
    "jszip": "3.10.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "uqr": "0.1.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.1",
    "@types/node": "22.10.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "fake-indexeddb": "6.2.5",
    "typescript": "5.7.3",
    "vite": "6.0.7",
    "vitest": "2.1.8"
  }
