{
  "name": "@coffee/journal",
  "version": "0.2.0",
  "private": true,
  "description": "Brew Journal — offline-first brewing log built on the grind conversion engine.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
