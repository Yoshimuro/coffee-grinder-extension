<?xml version="1.0" encoding="utf-8"?>
<!--
  Палитра нативной оболочки — СВЕТЛАЯ (BJ-6; тема добавлена в BJ-9).

  Библиотека capacitor-android приносит свои colorPrimary/Dark/Accent (индиго и
  розовый по умолчанию Material). Акцентного цвета у приложения нет вовсе —
  цвет в нём появляется только на колесе вкусов и на снимках пачек, — поэтому
  все три переопределяются здесь фоном и цветом текста из tokens.css.

  Ресурсы модуля приложения перекрывают одноимённые ресурсы библиотек, так что
  правка живёт ровно в этой паре файлов: тёмные значения — в `values-night/`.

  Почему светлая лежит в безымянном `values/`, хотя умолчание приложения тёмное:
  так устроен сам Android — «день» безымянен, ночь квалифицирована. Умолчание
  задаётся не расположением файлов, а тем, что при первом запуске веб-слой
  просит `MODE_NIGHT_YES` (`ShellThemePlugin`, `DEFAULT_PREF`).

  Важное: `values-night/` здесь следует НЕ системной теме, а нашей — ровно
  потому, что идёт в паре с `UiModeManager#setApplicationNightMode`. Убрать этот
  вызов и оставить квалификатор значит выдать светлую оболочку человеку, который
  выбрал тёмную тему на светлом телефоне.
-->
<resources>
    <color name="colorPrimary">#F7F7F4</color>
    <color name="colorPrimaryDark">#F7F7F4</color>
    <color name="colorAccent">#171715</color>

    <!-- Фон приложения: токен --bg светлой темы. Им же залиты статус-бар и
         панель навигации. -->
    <color name="bjBackground">#F7F7F4</color>
</resources>
