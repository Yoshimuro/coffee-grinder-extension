<?xml version="1.0" encoding="utf-8"?>
<!--
  Полярность значков системных панелей (BJ-9).

  Отдельным bool-ресурсом, а не вторым `styles.xml` в `values-night/`: между
  темами отличается ровно этот флаг, и дублировать ради него три стиля целиком
  значит завести две копии, которые рано или поздно разъедутся.

  Значение читается как «фон панелей светлый, значит значки на них тёмные».
-->
<resources>
    <bool name="bjLightStatusBar">true</bool>
</resources>
